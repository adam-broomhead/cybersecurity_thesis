{
    // The best model configs of each type for running on the test set
    // No smoothing best config
    "no_smoothing": {
        "w_inf": 0.24,

        // defaults
        "sampling_seed": 6554,
        "cluster_param": 1,
        "smoothing_target": 0,
        "clustering_matrix_name": "u",
        "clustering_transformation": "none",
        "distance_metric": "l2",
        "linear_smooth": true,
        "smooth_a_mu": 0.0,
        "smooth_a_sigma2": 0.0,
        "smooth_a_p": 0.0,
        "smooth_t_mu": 0,
        "smooth_t_sigma2": 0,
        "smooth_t_p": 0},


    // Cluster smoothing best configs
    "cluster_smoothing": {
        "sampling_seed": 6654,
        "clustering_seed": 6554,
        "w_inf": 0.34,

        "smooth_a_mu": 0.70,
        "smooth_a_sigma2": 0.45,
        "smooth_a_p": 0.35,
        "smooth_t_mu": 0,
        "smooth_t_sigma2": 0,
        "smooth_t_p": 0,
        "linear_smooth": true,
        "smoothing_target": 1,

        "cluster_param": 32,
        "clustering_matrix_name": "u_p",
        "clustering_transformation": "log",
        "distance_metric": "standardised_l2",
    },

    // Global smoothing best configs
    "global_smoothing": null,
}