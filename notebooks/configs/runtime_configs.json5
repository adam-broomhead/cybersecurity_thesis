{
    //////// Runtime configs
    // Contains configs for runtime step of pipeline
    // These will likely remain unchanged
    
    // Clustering configuration
    "seed" : 110,
    "clustering_method" : "k_clusters",
    "clustering_matrix_name" : "u",
    "distance_metric" : "l2",

    // Selected experimental condition
    "experiment_name" : "cluster_smoothing",

    // Determines the experiment to run
    "model_family_selected" : false,
    "final_config_selected" : false,

    // Calibration outputs
    "calibration_thresholds" : [0.001, 0.01, 0.05, 0.1, 0.2, 0.5, 0.9],

    // Tells us whether to evaluate only on the validation set
    "use_validation" : true,

    // ########################################
    // Hyperparameter defaults these are overwritten by the values in hyperparameter dictionary
    // TODO remove these later but keep until we can check it is running 
    // #########################################
    "w" : 0.1,
    "smooth_a" : 0.1, 
    "smooth_k" : 0.1, 
    "linear_smooth" : true, 
    "smoothing_target" : 0, 
    "hurdle_model" : true,
    "cluster_param" : 4,
    "experiment_name" : "cluster_smoothing",
}