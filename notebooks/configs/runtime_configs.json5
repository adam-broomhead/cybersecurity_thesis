{
    //////// Runtime configs
    // Contains configs for runtime step of pipeline
    // These will likely remain unchanged
    
    // setting the seed (used in k means) and clustering method
    "seed" : 110,
    "clustering_method" : "k_means",
    "clustering_matrix_name" : "u",
    
    // Calibration outputs and degen threshold (>= and we evaluate)
    "calibration_thresholds" : [0.001, 0.01, 0.05, 0.1, 0.2, 0.5, 0.9],

    // Tells us whether to evaluate only on the validation set
    "use_validation" : true,

    // ########################################
    // Hyperparameter defaults these are overwritten by the values in hyperparameter dictionary
    // TODO remove these later but keep until we can check it is running 
    // #########################################
    "w" : 0.1,
    "smooth_a" : 0.1, 
    "smooth_k" : 0.1, 
    "linear_smooth" : true, 
    "smoothing_target" : 0, 
    "hurdle_model" : true,
    "cluster_param" : 4,
}