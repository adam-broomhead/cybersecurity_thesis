{
    // These are the hyperparameter configurations experimented with
    "sampling_seed": 110,
    "n_hypers_sampled": 30,

    "w_decay_rate": [0.50, 0.75, 1.00, 1.25, 1.50],
    "w_inf": [0.10, 0.15, 0.20, 0.25, 0.30, 0.60],

    "cluster_param_vals": [2, 4, 8, 16, 32, 64],
    "smoothing_target": [0, 1, 2],

    "smoothing_a_mu_vals": [0.1, 0.2, 0.4, 1.0],
    "smoothing_a_sigma2_vals": [0.1, 0.2, 0.4, 1.0],
    "smoothing_a_p_vals": [0.1, 0.2, 0.4, 1.0],

    "smoothing_k_mu_vals": [2, 10, 50],
    "smoothing_k_sigma2_vals": [2, 10, 50],
    "smoothing_k_p_vals": [2, 10, 50],

    "clustering_matrix_name_vals": ["u", "log_u", "v", "normalised_u"],

    "distance_metric_vals": ["l2", "standardised_l2", "l1"],
}